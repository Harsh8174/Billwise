package com.app.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.app.enums.InvoiceStatus;
import com.app.models.Customer;
import com.app.models.Invoice;
import com.app.responsedto.Dashboardresponsedto;
import com.app.responsedto.Invoicedto;
import com.app.services.CustomerService;
import com.app.services.InvoiceService;

@RestController
@RequestMapping("invoice")
@CrossOrigin(origins = "http://localhost:5500",allowCredentials = "true")
public class InvoiceController {
	@Autowired
 private InvoiceService service;
	
	@Autowired
	private CustomerService cust_service;
	
	@PostMapping("add")
	public Invoice addinvoice(@RequestBody com.app.requestdto.Invoicedto invoice) {
		Invoice obj=new Invoice();
	    Customer customer=cust_service.getcustomer(invoice.getCustomerId());	
		obj.setCustomer(customer);
		obj.setInvoice_amount(invoice.getAmount());
		obj.setInvoice_date(invoice.getInvoiceDate());
		obj.setInvoice_due_date(invoice.getDueDate());
		obj.setInvoice_number(invoice.getNumber());
		obj.setInvoice_status(invoice.getStatus());
		obj.setDescription(invoice.getDescription());
		return service.addinvoice(obj);
	}
	
	@PostMapping("markPaid/{id}")
	public Invoice changestatus(@PathVariable int id) {
		Invoice invoice=service.getInvoiceById(id);
		invoice.setInvoice_status(InvoiceStatus.PAID);
		return service.addinvoice(invoice);
	}
}
