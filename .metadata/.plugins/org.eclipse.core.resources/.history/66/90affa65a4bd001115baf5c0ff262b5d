import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.app.models.JobExecution;
import com.app.models.SchedulerJob;
import com.app.repository.SchedulerJobs;
import com.app.requestdto.Schdulerdto;
import com.app.responsedto.Jobexecutionresponse;
import com.app.services.JobExecutionService;
import com.app.services.SchedulerService;

@RestController
@RequestMapping("schedule")
@CrossOrigin(origins = "http://localhost:5500",allowCredentials = "true")
public class SchedulerController {
	@Autowired
private	SchedulerService service;
	
	@Autowired 
	private JobExecutionService job_service;
	
	    @PostMapping("configure")
        public void addschedule(@RequestBody Schdulerdto dto) {
        	
	    	service.addscheduler(dto);
	    	
        }  
	    
	    @PatchMapping("/enable/{id}")
	    public SchedulerJob  enablejob(@PathVariable int id,@RequestBody Schdulerdto dto) {
 	    	return service.enabletstatus(id, dto);
	    }
	    
	    @PostMapping("runNow/{id}")
	    public JobExecution runnow(@PathVariable int id) {
	       
	        //return job_service.getalljobs();
	        return  service.RunNow(id); 
	    }
	    
	    @PatchMapping("job/{id}")
	    public void schedulejob(@PathVariable int id,@RequestBody Schdulerdto dto) {
	    	System.out.println(dto); 
	    	SchedulerJob job=service.getjob(id);
	    	dto.setJob_Name(job.getJob_name());
	    	dto.setReminder_type(job.getRemindertype());
	    	dto.setEnabled(job.isEnabled());
	    	dto.setFrequency("daily");
	    	service.addscheduler(dto);
	    }
}
