			     List<ReminderAttempt> reminder_list=dao_reminder.findAll();
			     obj.setReminder_list(reminder_list);
			     return obj;
		}
	
	List<Invoicedto> mapToInvoiceResponseDtoList(List<Invoice> invoice_list) {
		
		List<Invoicedto> list=new ArrayList<Invoicedto>(); 
		for (Invoice invoice : invoice_list) {
			Invoicedto dto=new Invoicedto();
			dto.setId(invoice.getId());
			dto.setInvoice_number(invoice.getInvoice_number());
			dto.setInvoice_amount(invoice.getInvoice_amount());
			dto.setInvoice_date(invoice.getInvoice_date());
			dto.setInvoice_due_date(invoice.getInvoice_due_date());
			dto.setInvoice_status(invoice.getInvoice_status());
			dto.setDescription(invoice.getDescription());
			dto.setCreated_at(invoice.getCreated_at());
			dto.setUpdated_at(invoice.getUpdated_at());
			dto.setCustomer(invoice.getCustomer());
			
			list.add(dto);
		}
	}
	

