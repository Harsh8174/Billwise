        public JobExecution RunNow(int id) {
        	SchedulerJob job=schedulerdao.getJobById(id);
        	automaticallysend(job); 
        JobExecution last_job	=  dao_jpa.findTopBySchedulerIdOrderByIdDesc(id);
        return last_job;
        }
	
public void automaticallysend(SchedulerJob schedulerJob) {
	
	System.out.println("automatocally sended called");
    JobExecution job = new JobExecution();
    job.setScheduler(schedulerJob);  
    job.setStarted_at(LocalTime.now());
    
    int found = 0, sent = 0, failed = 0, skipped = 0;
    LocalDate current_date = LocalDate.now();

    for (Invoice invoice : dao.findAll()) {
        if (invoice.getInvoice_status() == InvoiceStatus.PAID) continue;

        long day = ChronoUnit.DAYS.between(current_date, invoice.getInvoice_due_date());
        Reminderperiod type = (day > 0 && day < 5) ? Reminderperiod.Upcoming
                             : (day == 0) ? Reminderperiod.Due_Today
                             : Reminderperiod.Overdued;

        if (type != schedulerJob.getRemindertype()) continue; // not this job's concern

        found++;
        boolean alreadySent = attempt.existsByInvoiceIdAndDateAndRemainderperiod(invoice.getId(), current_date,schedulerJob.getRemindertype());
        if (alreadySent) {
            skipped++;
        } else {
		    	   ReminderAttempt remainder=new ReminderAttempt();
		    	   remainder.setInvoice(invoice);
		    	   remainder.setRemainderperiod(schedulerJob.getRemindertype());
		    	   remainder.setDate(Instant.now());
		    	   try {
		    	   service.sendmail(invoice.getCustomer().getEmail(), "Invoice Reminder", "Your Invoice number :"+invoice.getInvoice_number()+"\n Invoice due date :"+invoice.getInvoice_due_date());
		    	   remainder.setStatus("Success");
		    	   sent++;
		    	   attempt.save(remainder);
		    	   }catch (Exception e) {
		    		   remainder.setStatus("failure");
		    		   failed++;
		    		   attempt.save(remainder);
		    		   e.printStackTrace();
				}   
		       }
        }
    

    job.setFound(found); job.setSent(sent); job.setFailed(failed); job.setSkipped(skipped);
    job.setEnded_at(LocalTime.now());
   
      dao_jpa.save(job);
    schedulerJob.setLastRunAt(LocalDateTime.now());
    schedulerJob.setNextRunAt(computeNextRunAt(schedulerJob.getCron_expression()));
    schedulerdao.save(schedulerJob);
}
  
