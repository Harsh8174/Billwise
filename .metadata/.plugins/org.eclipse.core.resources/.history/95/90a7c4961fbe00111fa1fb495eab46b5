	//for next run 
	private LocalDateTime computeNextRunAt(String cronExpression) {
	    CronTrigger trigger = new CronTrigger(cronExpression);
	    TriggerContext context = new SimpleTriggerContext(); // empty = "starting from now"
	    Instant next = trigger.nextExecution(context);
	    return next == null ? null : LocalDateTime.ofInstant(next, ZoneId.systemDefault());
	}
	
	
	@Override
	public void addscheduler(Schdulerdto dto) {
		String job_name=dto.getJob_Name();
	    String frequency = dto.getFrequency();
	    LocalTime time=dto.getTime();
	    boolean enabled =dto.isEnabled();
	    String cron_expression=null;
	    if(frequency.equalsIgnoreCase("daily"))
	    {
	    	cron_expression = time.getSecond() +" "+time.getMinute()+" "+  time.getHour()+" * * *";
	    	//cron_expression = time.getSecond()+" * * * * *";
	    }
	    
		SchedulerJob obj=schedulerdao.getJobByRemindertype(dto.getReminder_type());
		if(obj==null) {
		obj=new SchedulerJob();	
		obj.setJob_name(job_name);
		obj.setCron_expression(cron_expression);
		obj.setEnabled(enabled);
		obj.setRemindertype(dto.getReminder_type());
		schedulerdao.save(obj);
		rescheduleJob(obj);
		}
		else {	
			obj.setCron_expression(cron_expression);
			obj.setEnabled(enabled);
			obj.setRemindertype(dto.getReminder_type());
			schedulerdao.save(obj);
			rescheduleJob(obj);
		}
	}
	
	private void rescheduleJob(SchedulerJob schedulerJob) {
	
		// 1. If a task is already running for this job's id, cancel it first
	    ScheduledFuture<?> existing = runningTasks.get(schedulerJob.getId());
	    if (existing != null) {
	    	System.out.println("existing");
	        existing.cancel(false); // false = let it finish if mid-run, just don't fire again
	        runningTasks.remove(schedulerJob.getId());
	    }

	    // 2. Only start a new one if it's actually enabled
	    if (schedulerJob.isEnabled()) {
	    	System.out.println("existing two called");
	        ScheduledFuture<?> future = taskscheduler.schedule(
	        		() -> automaticallysend(schedulerJob),
	            new CronTrigger(schedulerJob.getCron_expression())
	        );
	        runningTasks.put(schedulerJob.getId(), future);
	        schedulerJob.setNextRunAt(computeNextRunAt(schedulerJob.getCron_expression()));
	        schedulerdao.save(schedulerJob);
	    }
	}

