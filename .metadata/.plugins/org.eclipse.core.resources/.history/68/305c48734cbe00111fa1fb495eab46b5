		public Dashboardresponsedto sendresponse() {
			Dashboardresponsedto obj=new Dashboardresponsedto();
			     List<Invoice> invoice_list=invoiceservice.getallInvoices();
			     List<Invoicedto> list_dto=mapToInvoiceResponseDtoList(invoice_list);
			      
			     List<SchedulerJob> job_list=service_scheduler.getallschedulerjob();
			     
			     
			     obj.setJob_list(job_list);
			     List<JobExecution> execution_list=jobs_service.getalljobs();
