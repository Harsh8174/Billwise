	class SchedulerServiceImplTest {

	    @Mock
	    private Invoicejpa dao;

	    @Mock
	    private RemainderAttemptjpa attempt;

	    @Mock
	    private NotificatonService service;

	    @Mock
	    private SchedulerJobs schedulerdao;

	    @Mock
